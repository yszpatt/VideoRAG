.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.env
/data/
/videorag-data/
/downloads/
dist/
web/node_modules/
web/dist/
.workbuddy/
.codebuddy/
.data/

# 本地降级 ASR 侧车：大模型与本地 venv 不入库（模型经 videorag 下载/共享卷挂载）
deploy/asr/models/
deploy/asr/.venv/

# 本机数据目录 override（指向 ./.data，含真实数据路径，不入库）
docker-compose.override.yml

# compose 文件本地备份（不入库）
deploy/compose-backups/

# 本地生成物（笔记导出、UI 参考）
outputs/

# ---- Windows 桌面打包 ----
# uv 缓存：本机 %LOCALAPPDATA%\uv\cache 不可写时改用项目内缓存（UV_CACHE_DIR）
/.uv-cache/
# PyInstaller 中间产物（产物目录 dist/ 已在上面忽略）
build/
# 构建时下载的 ffmpeg 等外部二进制（体积大且带 GPL，不入库，由 packaging/vendor-ffmpeg.ps1 获取）
packaging/vendor/

# 预下载的 Python wheel 缓存（scripts/prefetch_wheels.sh 生成；体积大、可重建）
packaging/wheels/*
!packaging/wheels/.gitkeep
