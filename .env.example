# ============================================================
# videoRAG 配置模板
# 复制为 .env 后按需修改；.env 已加入 .gitignore，不会入库。
# 优先级：环境变量 > .env > 默认值（docker-compose 注入的 env 会覆盖 .env）
# ============================================================

# ---------- LLM（OpenAI 兼容格式） ----------
# 任意 OpenAI 兼容服务均可：改 LLM_BASE_URL + LLM_API_KEY + LLM_MODEL 即可
#   DeepSeek:  https://api.deepseek.com / deepseek-chat
#   OpenAI:    https://api.openai.com/v1 / gpt-4o-mini
#   本地 Ollama: http://<host>:11434/v1 / 你的模型名（如 ornith-1.5:9b，无需 key）
#   本地 vLLM: http://localhost:8000/v1 / 你的模型名
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# ---------- Embedding ----------
# fastembed = 本地 ONNX（默认，CPU 友好，首次下载约 100MB）
# openai   = 远程 OpenAI 兼容 /v1/embeddings（如 Ollama bge-m3）：
#   EMBED_PROVIDER=openai
#   EMBED_BASE_URL=http://<host>:11434/v1
#   EMBED_MODEL=bge-m3:latest
EMBED_PROVIDER=fastembed
EMBED_MODEL=BAAI/bge-small-zh-v1.5
EMBED_BASE_URL=
EMBED_API_KEY=

# ---------- ASR（转写） ----------
# 档位由 CLOUD_ASR_* 是否配置 + ASR_FALLBACK 共同决定（设置页「ASR」组可在线切换，无需重启）：
#   cloud ：下方 CLOUD_ASR_* 配齐（provider+base_url）→ 远程集中转写
#   local ：未配置远程 → 按 ASR_FALLBACK 走本地档（默认 SenseVoice 侧车，见文末「本地降级」）
#   none  ：ASR_FALLBACK=none 且无远程 → 禁用转写降级（仅字幕，不会偷跑大模型下载）

# ---- 远程集中式（可选；provider 决定发给服务的请求参数）----
# provider 含 "whisper"（如 faster-whisper-server）→ 发 vad_filter / hallucination_silence_threshold
#   / condition_on_previous_text 等防幻觉参数；segments 时间戳完整
# provider 其他（如 sensevoice / openai-whisper）→ 跳过 faster-whisper 专有参数；
#   必发 model 字段（部分服务缺则 400/422）；可能只返回 text，会自动兜底为整段
# 示例：SenseVoice 集中服务（Windows uv 直跑 jackuh105/openai-sensevoice-stt，GPU cuda）
#   CLOUD_ASR_PROVIDER=sensevoice
#   CLOUD_ASR_BASE_URL=http://192.168.x.x:9991
#   CLOUD_ASR_MODEL=sensevoice
#   CLOUD_ASR_KEY=local
# 示例：faster-whisper-server（CPU docker，segments 完整但慢）
#   CLOUD_ASR_PROVIDER=faster-whisper-server
#   CLOUD_ASR_BASE_URL=http://192.168.x.x:8000
#   CLOUD_ASR_KEY=local
CLOUD_ASR_PROVIDER=
CLOUD_ASR_BASE_URL=
CLOUD_ASR_KEY=
CLOUD_ASR_MODEL=

# ---------- MCP（agent 外挂，建议设置） ----------
MCP_API_KEY=

# ---------- 目录与运行 ----------
DATA_DIR=/data
COOKIE_DIR=/data/cookies
PORT=8080
MAX_CONCURRENT_TASKS=1

# ---------- 容器运行用户（Docker 形态，重要） ----------
# 容器以该 UID/GID 运行（镜像构建参数），使其与宿主用户一致：绑定挂载的数据卷
# 不再产生 root 属主文件，Docker 与裸机两种运行形态可共用同一份数据。
# 取值方法：id -u / id -g（多数桌面 Linux 为 1000；群晖 NAS 常见 1026）
# 修改后必须重新构建：docker compose up -d --build
VIDEORAG_UID=1000
VIDEORAG_GID=1000

# ---------- 检索策略（设置页「检索」组可在线调整，写 runtime.env 优先）----------
# 流水线：宽召回 → 加权 RRF 融合 → 相关性过滤 → 相邻切片合并 → 单视频配额
RETRIEVAL_VECTOR_K=24        # 向量召回条数（1~100）
RETRIEVAL_FTS_K=24           # 全文召回条数（1~100）
RETRIEVAL_RRF_K=60           # RRF 平滑常数，越大名次差异越平缓
RETRIEVAL_VECTOR_WEIGHT=0.7  # 向量路权重（语义相关性为主）
RETRIEVAL_FTS_WEIGHT=0.3     # 全文路权重（关键词/术语佐证）
RETRIEVAL_PER_VIDEO_CAP=3    # 单视频最多占的结果位数（0 = 不限）
RETRIEVAL_MIN_SIM=0.0        # 向量路最低余弦相似度门槛（0 = 关闭；建议 0.3）
RETRIEVAL_NEIGHBOR_GAP=2.0   # 相邻切片合并窗口（秒）；0 = 关闭

# ---------- 本地降级（Local Fallback，未配置远程时自动回落） ----------
# ASR 本地档位：sensevoice(默认, sherpa-onnx+SenseVoice int8, ≈240MB) | whisper(兼容档, faster-whisper,
#   需旧版 WHISPER_MODEL 指定权重，如 large-v3≈3GB，不推荐) | none(禁用降级)
#   none 时远程未配置 → 转写直接报「未配置 ASR」，不会偷跑本地大模型下载
#   whisper 兼容档可选指定：WHISPER_MODEL=small   # 默认 large-v3；权重经 HF 下载到 $DATA_DIR/models
ASR_FALLBACK=sensevoice
# 本地 SenseVoice 端点。留空按形态默认：
#   - Docker（compose --profile local-asr 启侧车）：注入 LOCAL_ASR_BASE_URL=http://asr:9991
#   - 裸机：默认 http://127.0.0.1:9991（deploy/asr/ 下 python server.py 起）
# 若侧车跑在别的机器/端口可显式覆盖
LOCAL_ASR_BASE_URL=
# 手动指定本地模型目录（留空 = 自动下载管理到 $DATA_DIR/models/asr）。
# 也可在「设置 → 本地模型」页操作（下载/取消/重试/删除/手动路径，写 runtime.env 持久化）
LOCAL_ASR_MODEL_DIR=
# 手动指定本地 fastembed 模型目录（直接含 model_optimized.onnx 的目录或 HF 缓存根）。
# 留空 = 自动下载管理到 $DATA_DIR/models（HF hub 缓存结构）
LOCAL_EMBED_MODEL_DIR=
# Embedding 下载镜像端点（内置下载首次拉取用；留空 = 官方 huggingface.co，国内可设
# https://hf-mirror.com）。仅影响自动下载，手动路径不受影响
EMBED_DOWNLOAD_ENDPOINT=

# ---------- 视觉旁路（E3，无语音视频的画面信息采集） ----------
# 当视频几乎没有对白时（纯音乐 MV / PPT 录屏 / 教程演示 / 代码演示等），
# 自动抽关键帧 + OCR 识别画面文字，并入「转写→笔记→切片入库→问答」链路。
# 档位：off=关闭 | auto=检测到无语音才走（默认）| always=强制（调试用）
VISUAL_PIPELINE=auto
# 无语音判定阈值（字/分钟）：语音密度低于该值即视为无语音视频
VISUAL_MIN_WPM=10
# 送 OCR/VLM 的最大关键帧数（先场景检测帧 + 每 30s 兜底帧，去重后均匀采样封顶）
VISUAL_MAX_FRAMES=60

# ---------- VLM（画面描述，可选增强；本版仅预留接口，不发起真实调用） ----------
# OpenAI 兼容视觉模型三件套；留空 = 画面描述层不启用（仅本地 OCR 层工作）。
# 例：阿里百炼 qwen-vl-flash / 智谱 GLM-4.6V-Flash / 本地 vLLM 视觉模型
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=
